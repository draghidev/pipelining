<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- DRAGHI001: in-box composition of the experimental Internal-namespace primitives. -->
        <NoWarn>$(NoWarn);DRAGHI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Draghi.Pipelining.Benchmarks" />
        <InternalsVisibleTo Include="Draghi.Pipelining.Tests" />
    </ItemGroup>

</Project>
