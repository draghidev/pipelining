<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- DRAGHI001: in-box composition of the experimental Internal-namespace primitives. -->
        <NoWarn>$(NoWarn);DRAGHI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Draghi.Pipelining.Benchmarks" />
        <InternalsVisibleTo Include="Draghi.Pipelining.Tests" />
    </ItemGroup>

</Project>
